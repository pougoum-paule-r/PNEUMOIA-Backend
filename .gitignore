# ── Secrets — JAMAIS sur GitHub ───────────────────────────────────────────────
.env
.env.*
.env.local

# ── Environnement virtuel Python ──────────────────────────────────────────────
venv/
.venv/

# ── Cache Python ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── Uploads utilisateurs (données dynamiques, non versionnées) ────────────────
uploads/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Datasets lourds (fichiers d'entraînement, non nécessaires au build) ───────
*.xlsx
*.h5
*.onnx

# IMPORTANT : les fichiers .pkl (modèles ML) sont inclus dans le repo
# car ils sont nécessaires au fonctionnement de l'application Docker.
# Si leur taille dépasse 100 Mo, utiliser Git LFS.

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

.pkl
.onnx