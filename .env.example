# ============================================================
#  PneumoIA — Variables d'environnement (.env.example)
#  Copiez ce fichier en .env et renseignez vos valeurs
#  IMPORTANT: Ne commitez JAMAIS le fichier .env en production!
# ============================================================

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=PneumoIA Backend
APP_VERSION=1.0.0
ENVIRONMENT=dev                    # dev, staging, prod, test
DEBUG=True                         # False en production
LOG_LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text                    # text ou json

# ── Base de données PostgreSQL ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@localhost:5432/pneumoia
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# ── JWT & Sécurité ───────────────────────────────────────────────────────
# ⚠️  SECRET_KEY: Générez une clé de 256 bits minimum
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changez-ce-secret-en-production-256-bits-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & Frontend ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Upload Fichiers ───────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ── Email SMTP ────────────────────────────────────────────────────────────
# Recommandé: Brevo (gratuit 300/jour, sans domaine requis)
# Alternative: Gmail, Mailtrap, SendGrid, etc.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com          # email de ton compte Brevo
SMTP_PASSWORD=xsmtpsib-xxxx            # clé SMTP générée dans Brevo
FROM_EMAIL=ton_email@gmail.com         # adresse expéditeur vérifiée
SMTP_TLS=True

# ── SMS (Twilio) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+237xxxxxxxxx       # numéro Twilio expéditeur
ADMIN_PHONE=+237xxxxxxxxx               # numéro de l'admin

# ── Admin Initial ─────────────────────────────────────────────────────────
# ⚠️  À changer immédiatement après le déploiement!
ADMIN_EMAIL=adminpneumoia@gmail.com
ADMIN_PASSWORD=Admin1234!

# ── AWS S3 ────────────────────────────────────────────────────────────────
# Optionnel si vous utilisez S3 pour le stockage
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx...
AWS_S3_BUCKET=pneumoia-uploads
AWS_S3_REGION=us-east-1

# ── ML Models ─────────────────────────────────────────────────────────────
MODEL_BASE_PATH=app/ml_models/model_base.pkl
MODEL_EQUIPE_PATH=app/ml_models/model_equipe.pkl
MODEL_METADATA_PATH=app/ml_models/metadata.json

# ── Celery (Async Tasks) ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=280

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/2
REDIS_CACHE_TTL=3600
