# ============================================================
#  PneumoIA — Variables d'environnement (.env.example)
#  Copiez ce fichier en .env et renseignez vos valeurs
# ============================================================

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:votre_mot_de_passe@localhost:5432/pneumoia

# JWT
SECRET_KEY=changez-ce-secret-en-production-256-bits-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email SMTP ─────────────────────────────────────────────────────────────
# Brevo (recommandé - gratuit 300/jour, sans domaine requis)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com          # email de ton compte Brevo
SMTP_PASSWORD=xsmtpsib-xxxx            # clé SMTP générée dans Brevo (pas ton vrai mdp)
FROM_EMAIL=ton_email@gmail.com         # adresse expéditeur vérifiée dans Brevo

# ── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+237xxxxxxxxx
ADMIN_PHONE=+237xxxxxxxxx

# ── Application ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
UPLOAD_DIR=./uploads
